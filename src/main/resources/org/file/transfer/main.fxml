<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.file.transfer.controller.MainController"
      spacing="20" alignment="CENTER" style="-fx-background-color: #1e1e1e;">
    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <!-- Tiêu đề -->
    <Label text="P2P File Transfer - UDP Reliable"
           style="-fx-text-fill: #00ffaa; -fx-font-size: 28px; -fx-font-weight: bold;"/>

    <!-- Dòng hiển thị IP + Port của mình -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="IP của bạn:" style="-fx-text-fill: #aaaaaa; -fx-font-weight: bold;"/>
        <Label fx:id="lblMyIp" text="Đang lấy IP..."
               style="-fx-text-fill: #00ffaa; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Label text="• Cổng:" style="-fx-text-fill: #aaaaaa; -fx-font-weight: bold;"/>
        <Label fx:id="lblMyPort" text="?"
               style="-fx-text-fill: #00ffaa; -fx-font-size: 18px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Nhập IP + Port đối phương -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="IP Đối Phương:" style="-fx-text-fill: #e0e0e0;"/>
        <TextField fx:id="tfIp" prefWidth="200" promptText="192.168.1.100"/>
        <Label text="Port:" style="-fx-text-fill: #e0e0e0;"/>
        <TextField fx:id="tfPort" prefWidth="100" promptText="4848"/>
    </HBox>

    <!-- Các nút hành động -->
    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="btnChooseFile" text="Chọn File Gửi" onAction="#chooseFile"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 15px; -fx-padding: 12 28;"/>

        <Button fx:id="btnSendFile" text="Gửi File" onAction="#sendFile" disable="true"
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 15px; -fx-padding: 12 28;"/>

        <Button text="Bắt Đầu Nhận" onAction="#startReceiving"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 15px; -fx-padding: 12 28;"/>
    </HBox>

    <!-- Trạng thái -->
    <Label fx:id="lblStatus" text="Sẵn sàng..."
           style="-fx-text-fill: #ff9800; -fx-font-size: 16px; -fx-font-weight: bold;"/>

    <!-- Thanh tiến độ -->
    <ProgressBar fx:id="progressBar" prefWidth="580" progress="0" visible="false"/>

    <!-- Thông tin truyền -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Tốc độ:" style="-fx-text-fill: #aaa;"/>
        <Label fx:id="lblSpeed" text="0 KB/s" style="-fx-text-fill: #00ffaa; -fx-font-weight: bold;"/>
        <Label text="• Đã truyền:" style="-fx-text-fill: #aaa;"/>
        <Label fx:id="lblTransferred" text="0 / 0 bytes" style="-fx-text-fill: #00ffaa; -fx-font-weight: bold;"/>
    </HBox>

    <Separator/>

    <!-- Danh sách file đã nhận -->
    <VBox spacing="10">
        <Label text="File đã nhận:" style="-fx-text-fill: #e0e0e0; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        <ListView fx:id="listReceived" prefHeight="200"
                  style="-fx-background-color: #2d2d2d; -fx-control-inner-background: #2d2d2d;"/>
    </VBox>
</VBox>