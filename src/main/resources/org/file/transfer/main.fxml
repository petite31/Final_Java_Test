<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.file.transfer.controller.MainController" 
      stylesheets="@styles.css" styleClass="root" spacing="0">
    
    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        
        <!-- HOME TAB -->
        <Tab text="Home">
            <VBox spacing="24" styleClass="root">
                <padding>
                    <Insets top="32" right="32" bottom="32" left="32"/>
                </padding>
                
                <Label text="FileTransfer" styleClass="title-label"/>
                <Label text="P2P File Sharing with Authentication" styleClass="subtitle-label"/>
                
                <HBox spacing="20">
                    <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                        <Label text="CONNECTION STATUS" styleClass="section-header"/>
                        <Label fx:id="lblStatus" text="Ready" styleClass="highlight-value"/>
                    </VBox>
                    
                    <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                        <Label text="MY PASSKEY" styleClass="section-header"/>
                        <Label fx:id="lblMyPasskey" text="------" style="-fx-text-fill: #E91E63; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label text="Share this with sender" styleClass="info-label"/>
                    </VBox>
                </HBox>
                
                <VBox styleClass="card" spacing="12">
                    <Label text="NETWORK INFORMATION" styleClass="section-header"/>
                    <GridPane hgap="40" vgap="12">
                        <VBox spacing="4" GridPane.columnIndex="0">
                            <Label text="Local IP Address" styleClass="info-label"/>
                            <Label fx:id="lblMyIp" text="Detecting..." styleClass="highlight-value"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="1">
                            <Label text="Listening Port" styleClass="info-label"/>
                            <Label text="6969" styleClass="highlight-value"/>
                        </VBox>
                    </GridPane>
                </VBox>
                
                <VBox styleClass="card" spacing="12">
                    <Label text="SETTINGS" styleClass="section-header"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Save Location" styleClass="info-label"/>
                            <Label fx:id="lblSavePath" text="~/Downloads/FileTransfer" style="-fx-text-fill: #546E7A; -fx-font-size: 12px;"/>
                        </VBox>
                        <Button text="Change Folder" onAction="#chooseSaveLocation" styleClass="button-secondary"/>
                    </HBox>
                    <Separator/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Network Mode" styleClass="info-label"/>
                            <Label text="Allow connections from outside local network" style="-fx-text-fill: #78909C; -fx-font-size: 11px;"/>
                        </VBox>
                        <CheckBox fx:id="cbAllowExternal" text="Allow External" onAction="#toggleNetworkMode"/>
                    </HBox>
                </VBox>
            </VBox>
        </Tab>
        
        <!-- SEND TAB -->
        <Tab text="Send Files">
            <VBox spacing="24" styleClass="root">
                <padding>
                    <Insets top="32" right="32" bottom="32" left="32"/>
                </padding>
                
                <Label text="Send Files" styleClass="title-label"/>
                
                <HBox spacing="20">
                    <!-- File Selection Area with Drag & Drop -->
                    <VBox styleClass="card" spacing="16" HBox.hgrow="ALWAYS" alignment="CENTER" 
                          style="-fx-border-style: dashed; -fx-border-color: #B0BEC5; -fx-border-width: 2; -fx-min-height: 200;"
                          fx:id="dropZone">
                        <Label text="📁 Select or Drop File Here" style="-fx-font-size: 18px; -fx-text-fill: #78909C;"/>
                        <Button fx:id="btnChooseFile" text="Choose File" onAction="#chooseFile" styleClass="button-primary"/>
                        <Label fx:id="lblSelectedFile" text="No file selected" styleClass="info-label"/>
                    </VBox>
                    
                    <!-- Recipient Info -->
                    <VBox styleClass="card" spacing="16" minWidth="300">
                        <Label text="RECIPIENT DETAILS" styleClass="section-header"/>
                        <VBox spacing="8">
                            <Label text="IP Address" styleClass="info-label"/>
                            <TextField fx:id="tfIp" promptText="e.g. 192.168.1.10"/>
                        </VBox>
                        <VBox spacing="8">
                            <Label text="Passkey" styleClass="info-label"/>
                            <PasswordField fx:id="tfPasskey" promptText="6-digit code"/>
                        </VBox>
                        <Button fx:id="btnSendFile" text="Send File" onAction="#sendFile" styleClass="button-primary" maxWidth="Infinity" disable="true"/>
                    </VBox>
                </HBox>
                
                <!-- Progress -->
                <VBox styleClass="card" spacing="12">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="TRANSFER PROGRESS" styleClass="section-header"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblSpeed" text="0 KB/s" style="-fx-font-size: 12px; -fx-text-fill: #78909C;"/>
                    </HBox>
                    <ProgressBar fx:id="progressBar" prefWidth="Infinity" progress="0" visible="false"/>
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label fx:id="lblTransferred" text="0 / 0 bytes" style="-fx-font-size: 12px; -fx-text-fill: #37474F;"/>
                        <Label fx:id="lblTimeRemaining" text="" style="-fx-font-size: 12px; -fx-text-fill: #78909C;"/>
                    </HBox>
                </VBox>
            </VBox>
        </Tab>
        
        <!-- RECEIVE TAB -->
        <Tab text="Receive Files">
            <VBox spacing="24" styleClass="root" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="32" right="32" bottom="32" left="32"/>
                </padding>
                
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Label text="Received Files" styleClass="title-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ToggleButton fx:id="btnViewList" text="List" onAction="#switchToListView" selected="true">
                        <toggleGroup>
                            <ToggleGroup fx:id="viewGroup"/>
                        </toggleGroup>
                    </ToggleButton>
                    <ToggleButton fx:id="btnViewGrid3" text="Grid 3x3" onAction="#switchToGrid3" toggleGroup="$viewGroup"/>
                    <ToggleButton fx:id="btnViewGrid4" text="Grid 4x4" onAction="#switchToGrid4" toggleGroup="$viewGroup"/>
                    <Separator orientation="VERTICAL"/>
                    <Button text="Open Folder" onAction="#openDownloadFolder" styleClass="button-secondary"/>
                    <Button text="Refresh" onAction="#refreshReceivedFiles" styleClass="button-icon"/>
                </HBox>
                
                <StackPane VBox.vgrow="ALWAYS">
                    <ListView fx:id="listReceived" styleClass="list-view" 
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);"/>
                    <ScrollPane fx:id="scrollGrid" fitToWidth="true" visible="false" style="-fx-background-color: transparent;">
                        <TilePane fx:id="gridReceived" hgap="20" vgap="20" style="-fx-padding: 20;"/>
                    </ScrollPane>
                </StackPane>
            </VBox>
        </Tab>
        
    </TabPane>
    
</VBox>