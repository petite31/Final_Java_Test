<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="30.0" style="-fx-background-color: #F4F7FE;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.file.transfer.controller.SettingsController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <children>
      <Label styleClass="title-label" text="Settings" />
      <VBox spacing="20.0" styleClass="card">
         <children>
            <Label styleClass="section-header" text="GENERAL" />
            <VBox spacing="10.0">
               <children>
                  <Label styleClass="info-label" text="Save Location" />
                  <Label fx:id="lblSavePath" styleClass="highlight-value" text="C:/Users/Downloads" />
                  <Button mnemonicParsing="false" onAction="#changeSaveLocation" styleClass="button-secondary" text="Change Location" />
               </children>
            </VBox>
         </children>
      </VBox>
      <VBox spacing="20.0" styleClass="card">
         <children>
            <Label styleClass="section-header" text="NETWORK" />
            <VBox spacing="10.0">
               <children>
                   <Label text="Protocol" style="-fx-font-weight: bold;"/>
                   <CheckBox fx:id="cbUdp" text="UDP (Wi-Fi LAN)"/>
                   <CheckBox fx:id="cbBluetooth" text="Bluetooth (RFCOMM)"/>
                   
                   <Separator/>
                   
                   <RadioButton fx:id="rbLan" mnemonicParsing="false" selected="true" text="Local Network Only (LAN)">
                     <toggleGroup>
                        <ToggleGroup fx:id="netGroup" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton fx:id="rbExternal" mnemonicParsing="false" text="Allow External Connections" toggleGroup="$netGroup" />
               </children>
            </VBox>
            <Separator prefWidth="200.0" />
            <Button mnemonicParsing="false" onAction="#testNetwork" styleClass="button-primary" text="Test Network Connection" />
         </children>
      </VBox>
   </children>
</VBox>
