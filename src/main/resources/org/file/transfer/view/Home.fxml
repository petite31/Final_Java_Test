<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="30.0" style="-fx-background-color: #F4F7FE;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.file.transfer.controller.HomeController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <children>
      <Label styleClass="title-label" text="Dashboard" />
      <HBox spacing="30.0">
         <children>
            <VBox prefHeight="200.0" prefWidth="300.0" styleClass="card">
               <children>
                  <Label styleClass="section-header" text="MY PASSKEY" />
                  <Label fx:id="lblPasskey" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #4318FF;" text="------" />
                  <Label styleClass="info-label" text="Share this code to receive files" />
                  <Button mnemonicParsing="false" onAction="#generateNewPasskey" styleClass="button-secondary" text="Generate New">
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Button>
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="300.0" styleClass="card">
               <children>
                  <Label styleClass="section-header" text="CONNECTION INFO" />
                  <HBox spacing="10.0">
                     <children>
                        <Label styleClass="info-label" text="IP Address:" />
                        <Label fx:id="lblIp" styleClass="highlight-value" text="Detecting..." />
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Label styleClass="info-label" text="Hostname:" />
                        <Label fx:id="lblHostname" styleClass="highlight-value" text="Unknown" />
                     </children>
                  </HBox>
                  <Button mnemonicParsing="false" onAction="#refreshIp" styleClass="button-icon" text="Refresh IP">
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Button>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
