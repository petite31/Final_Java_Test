<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" style="-fx-background-color: #F4F4F4;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.file.transfer.controller.ReceiverFilesController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Label styleClass="title-label" text="Transfer History" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#refresh" styleClass="button-icon" text="↻" />
            <Button mnemonicParsing="false" onAction="#handleDeleteAll" styleClass="button-secondary" text="Clear History" />
         </children>
      </HBox>
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
          <Tab text="All Transactions">
               <content>
                  <TableView fx:id="allTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colType" prefWidth="75.0" text="Type" />
                      <TableColumn fx:id="colPeer" prefWidth="90.0" text="User" />
                        <TableColumn fx:id="colFile" prefWidth="130.0" text="File Name" />
                        <TableColumn fx:id="colSize" prefWidth="90.0" text="Size" />
                        <TableColumn fx:id="colTime" prefWidth="150.0" text="Time" />
                        <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                        <TableColumn fx:id="colAction" prefWidth="160.0" text="Action" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </content>
          </Tab>
          <Tab text="Sent">
               <content>
                  <TableView fx:id="sentTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colSentPeer" prefWidth="90.0" text="Receiver" />
                        <TableColumn fx:id="colSentFile" prefWidth="130.0" text="File Name" />
                        <TableColumn fx:id="colSentSize" prefWidth="90.0" text="Size" />
                        <TableColumn fx:id="colSentTime" prefWidth="150.0" text="Time" />
                        <TableColumn fx:id="colSentStatus" prefWidth="100.0" text="Status" />
                        <TableColumn fx:id="colSentAction" prefWidth="160.0" text="Action" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </content>
          </Tab>
            <Tab text="Received">
               <content>
                  <TableView fx:id="receivedTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colReceivedPeer" prefWidth="90.0" text="Sender" />
                        <TableColumn fx:id="colReceivedFile" prefWidth="130.0" text="File Name" />
                        <TableColumn fx:id="colReceivedSize" prefWidth="90.0" text="Size" />
                        <TableColumn fx:id="colReceivedTime" prefWidth="150.0" text="Time" />
                        <TableColumn fx:id="colReceivedStatus" prefWidth="100.0" text="Status" />
                        <TableColumn fx:id="colReceivedAction" prefWidth="160.0" text="Action" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
</VBox>
