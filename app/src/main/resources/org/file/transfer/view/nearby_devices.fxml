<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-padding: 40;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.file.transfer.controller.NearbyDevicesController">

    <Label prefHeight="31.0" prefWidth="233.0" styleClass="title-label" text="Nearby Devices" />
    <Label styleClass="subtitle-label" text="Double-click to connect or select and click Connect" />

    <TableView fx:id="tablePeers" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colName" prefWidth="150" text="Username" />
            <TableColumn fx:id="colIp" prefWidth="120" text="IP Address" />
            <TableColumn fx:id="colPort" prefWidth="80" text="Port" />
            <TableColumn fx:id="colMech" prefWidth="124.0" text="Mechanism" />
            <TableColumn fx:id="colStatus" prefWidth="76.0" text="Status" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="15">
        <Button onAction="#refreshPeers" styleClass="button-secondary" text="Refresh" />
        <Button fx:id="btnConnect" disable="true" onAction="#connectToPeer" styleClass="button-primary" text="Connect" />
    </HBox>
</VBox>
